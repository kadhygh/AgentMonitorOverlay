{
  "name": "amo-studio",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/testkit",
    "packages/account",
    "packages/locate",
    "packages/traymenu",
    "packages/host",
    "packages/reviewer",
    "packages/app",
    "packages/notes",
    "packages/relay",
    "packages/relay-ui",
    "packages/relay-app",
    "packages/platform",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w @amo-studio/ui",
    "typecheck": "tsc -b && tsc -p packages/ui --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "tsc -b && npm run build -w @amo-studio/ui",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:codex-mock": "tsc -b && node packages/testkit/scripts/verify-mock-codex.mjs",
    "host": "tsc -b && node packages/host/dist/bin.js",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "start": "npm run build && electron packages/app",
    "notes": "npm run build && electron packages/notes",
    "reviewer": "npm run build && electron packages/reviewer/dist/main.js",
    "platform": "npm run build && electron packages/platform",
    "relay": "tsc -b packages/relay && node packages/relay/dist/bin.js",
    "relay:release": "node scripts/relay-release.mjs",
    "relay:mac": "node scripts/relay-mac.mjs",
    "release": "node scripts/release.mjs",
    "host:stop": "node scripts/host-stop.mjs",
    "package:portable": "npm run build && node scripts/package-portable.mjs release --zip",
    "package:platform": "npm run build && node scripts/package-portable.mjs --platform",
    "smoke:portable": "node scripts/smoke-portable.mjs release",
    "tutorial:build": "node scripts/build-tutorial.mjs",
    "tutorial:shots": "node scripts/build-tutorial.mjs && node scripts/tutorial-shots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "rcedit": "5.0.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

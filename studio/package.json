{
  "name": "amo-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/testkit",
    "packages/host",
    "packages/app",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w @amo-studio/ui",
    "typecheck": "tsc -b && tsc -p packages/ui --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "tsc -b && npm run build -w @amo-studio/ui",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:codex-mock": "tsc -b && node packages/testkit/scripts/verify-mock-codex.mjs",
    "host": "tsc -b && node packages/host/dist/bin.js",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "smoke:stage1": "npm run build && node scripts/smoke-stage1.mjs",
    "smoke:stage4": "npm run build && node scripts/smoke-stage4.mjs",
    "smoke:stage5": "npm run build && node scripts/smoke-stage5.mjs",
    "start": "npm run build && electron packages/app",
    "host:stop": "node scripts/host-stop.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

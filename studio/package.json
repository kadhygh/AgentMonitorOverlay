{
  "name": "amo-studio",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/testkit",
    "packages/host",
    "packages/reviewer",
    "packages/app",
    "packages/notes",
    "packages/relay",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w @amo-studio/ui",
    "typecheck": "tsc -b && tsc -p packages/ui --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "tsc -b && npm run build -w @amo-studio/ui",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:codex-mock": "tsc -b && node packages/testkit/scripts/verify-mock-codex.mjs",
    "host": "tsc -b && node packages/host/dist/bin.js",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "smoke:stage1": "npm run build && node scripts/smoke-stage1.mjs",
    "smoke:stage4": "npm run build && node scripts/smoke-stage4.mjs",
    "smoke:stage5": "npm run build && node scripts/smoke-stage5.mjs",
    "smoke:stage6": "npm run build && node scripts/smoke-stage6.mjs",
    "smoke:stage7": "npm run build && node scripts/smoke-stage7.mjs",
    "start": "npm run build && electron packages/app",
    "notes": "npm run build && electron packages/notes",
    "reviewer": "npm run build && electron packages/reviewer/dist/main.js",
    "relay": "tsc -b packages/relay && node packages/relay/dist/bin.js",
    "relay:bundle": "tsc -b packages/relay && rolldown packages/relay/dist/bin.js --platform node --format esm --file release/relay/amo-relay.mjs",
    "host:stop": "node scripts/host-stop.mjs",
    "package:portable": "npm run build && node scripts/package-portable.mjs release --zip",
    "smoke:portable": "node scripts/smoke-portable.mjs release"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "rcedit": "5.0.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

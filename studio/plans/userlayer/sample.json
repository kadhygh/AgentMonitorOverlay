    {
      "id": "i1", "num": 1, "short": "今天何时部署", "type": "decision", "importance": "high", "area": "deploy", "status": "needs_you", "owner": "human", "source": "curator",
      "title": "今天什么时候再部署一次中转？",
      "summary": "#5 和 #9 的修复上午能好。部署会让中转重启几秒，在线的人会断一下线。",
      "body": "现在服务器上是 0.7.6。上午值守在修 #9（曲线），维护迭代在修 #5（页签数字），两个都改中转服务，要再部署一次才生效。\n\n部署走 `npm run release -- relay-service`，会重启中转几秒：正在聊天的人会断线重连，正在打包的进度上报会丢一次。",
      "ask": {
        "question": "#5、#9 修好之后，什么时候部署？",
        "options": [
          { "id": "now", "label": "修好就部署", "detail": "最快生效，可能打断正在聊天的人" },
          { "id": "noon", "label": "午饭时间部署", "detail": "12:00–13:00 在线的人最少" },
          { "id": "night", "label": "攒到晚上一起", "detail": "白天再有修复也一起带上" }
        ],
        "recommend": "noon",
        "why": "两个修复都不急（只影响管理页和一个页签数字），午饭时间在线的人最少，断线影响最小。",
        "deep": false
      },
      "evidence": [
        { "kind": "commit", "ref": "3a19b035", "note": "chore(release): 中转服务 0.7.6，现在线上的版本" },
        { "kind": "file", "ref": "AGENTS.md", "note": "relay-service 会重启中转几秒" }
      ],
      "createdAt": "2026-11-01T08:10:00+08:00", "updatedAt": "2026-11-01T08:10:00+08:00"
    },
    {
      "id": "i2", "num": 2, "short": "断掉的打包怎么记", "type": "decision", "importance": "normal", "area": "progress", "status": "needs_you", "owner": "human", "source": "iter",
      "title": "打包中途断了（电脑关了），记「失败」还是单独记「中断」？",
      "summary": "现在没报结束就又开始新一次的，一律记成失败。失败率会虚高，中位数也会被拉偏。",
      "body": "0.7.4 的规则：一次打包没报结束，下一次就开始了，就把上一次记成失败。\n\n10-31 有 2 次是晚上关机断的，现在打包记录里显示成两个红色的失败，「提交版本」这一步的中位数也被拉长了。",
      "ask": {
        "question": "断掉的打包怎么记？",
        "options": [
          { "id": "fail", "label": "维持记失败", "detail": "不用改" },
          { "id": "interrupted", "label": "新增「中断」", "detail": "灰色显示，不算进失败率和中位数" },
          { "id": "drop", "label": "直接不记", "detail": "记录里看不到这次" }
        ],
        "recommend": "interrupted",
        "why": "打包记录是用来估时间、看哪一步常出问题的。关机不是打包的问题，混进失败里会误导。",
        "deep": false
      },
      "evidence": [
        { "kind": "file", "ref": "studio/packages/relay/CHANGELOG.md", "note": "0.7.4 节：没报结束就又开始了新一次的，记成失败" },
        { "kind": "file", "ref": "studio/scripts/release.mjs", "note": "打包进度从这里上报" },
        { "kind": "session", "ref": "维护迭代 · 10-31", "note": "讨论过这条，没定" }
      ],
      "createdAt": "2026-10-31T18:40:00+08:00", "updatedAt": "2026-10-31T18:40:00+08:00"
    },
    {
      "id": "i3", "num": 3, "short": "脏工作区拒绝部署？", "type": "question", "importance": "high", "area": "deploy", "status": "needs_you", "owner": "human", "source": "curator",
      "title": "部署中转时工作区有没提交的改动，要不要直接拒绝？",
      "summary": "10-31 上午有一次部署没提交，下午 0.7.1 部署时把它冲掉了，到 0.7.2 才补回来。",
      "body": "整理员在 0.7.2 的改动说明里看到这句：「10-31 上午部署过一次（没提交），被 0.7.1 覆盖掉了，这一版恢复。」\n\n`AGENTS.md` 已经写了「不要绕过 release 直接 deploy 没提交的中转改动」，但这次还是发生了。",
      "ask": {
        "question": "部署脚本发现有没提交的改动时怎么办？",
        "options": [
          { "id": "refuse", "label": "拒绝部署", "detail": "提示先提交，再部署" },
          { "id": "warn", "label": "只警告", "detail": "列出没提交的文件，问一句还要不要继续" },
          { "id": "none", "label": "不管", "detail": "维持现状" }
        ],
        "recommend": "refuse",
        "why": "规矩靠人和 AI 记，总有记不住的时候，交给脚本就不会再发生。",
        "deep": false
      },
      "evidence": [
        { "kind": "file", "ref": "studio/packages/relay/CHANGELOG.md", "note": "0.7.2 节：上午那次部署被 0.7.1 覆盖" },
        { "kind": "file", "ref": "AGENTS.md", "note": "常用命令 → relay-service 那条" }
      ],
      "createdAt": "2026-11-01T08:05:00+08:00", "updatedAt": "2026-11-01T08:05:00+08:00"
    },
